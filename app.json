{
  "name": "Nexa VC Fighter",
  "description": "Multi-Assistant Telegram VC Fighter Bot",
  "repository": "https://github.com/AMMUKASH/Nexa-Vc-Fighter",
  "keywords": ["telegram", "userbot", "vc-fighter", "pyrogram"],
  "env": {
    "API_ID": {
      "description": "Your Telegram API ID from my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "Your Telegram API HASH from my.telegram.org",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Bot Token from @BotFather",
      "required": true
    },
    "OWNER_ID": {
      "description": "Your Telegram User ID",
      "required": true
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ]
}
